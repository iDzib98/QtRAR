/* Hoja de estilos del tema "original".
 *
 * Imita el aspecto clasico de WinRAR: cromado gris claro (#F0F0F0), bordes con
 * relieve, seleccion azul, tipografia compacta de 9 puntos y botones de barra
 * de herramientas planos de 16 px.
 *
 * Se aplica desde ThemeManager::setTheme(Original). Con el tema "system" esta
 * hoja se descarta y manda el estilo del escritorio.
 */

QWidget {
    font-family: "Segoe UI", "Cantarell", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 9pt;
}

QMainWindow,
QDialog {
    background-color: #F0F0F0;
}

QMenuBar {
    background-color: #F0F0F0;
    border-bottom: 1px solid #D4D0C8;
    padding: 1px;
}

QMenuBar::item {
    padding: 3px 8px;
    background: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #CDE0F7;
    border: 1px solid #7A9CC6;
    border-radius: 2px;
}

QMenu {
    background-color: #F0F0F0;
    border: 1px solid #ACA899;
    padding: 2px;
}

QMenu::item {
    padding: 4px 26px 4px 24px;
}

QMenu::item:selected {
    background-color: #3399FF;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #A0A0A0;
}

QMenu::separator {
    height: 1px;
    background-color: #D4D0C8;
    margin: 3px 6px;
}

QToolBar {
    background-color: #F0F0F0;
    border: 0px;
    border-bottom: 1px solid #D4D0C8;
    spacing: 1px;
    padding: 2px;
}

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 2px;
    /* El texto va centrado bajo el icono, como en WinRAR. */
    text-align: center;
}

QToolButton:hover {
    border: 1px solid #B5B5B5;
    background-color: #F5F5F5;
}

QToolButton:pressed,
QToolButton:checked {
    background-color: #E0E0E0;
    border: 1px solid #A0A0A0;
}

QToolButton:disabled {
    opacity: 0.4;
}

/* La barra de direcciones de WinRAR va incrustada sobre el fondo de la lista. */
QComboBox#addressBar {
    background-color: #FFFFFF;
    border: 1px solid #7A9CC6;
    border-radius: 2px;
    padding: 2px 4px;
    min-height: 20px;
}

QComboBox#addressBar:focus {
    border: 1px solid #3399FF;
}

QComboBox#addressBar::drop-down {
    border: none;
    width: 16px;
}

QComboBox#addressBar QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #7A9CC6;
    selection-background-color: #3399FF;
    selection-color: #FFFFFF;
    outline: none;
}

QPushButton {
    background-color: #F0F0F0;
    border: 1px solid #ACA899;
    border-radius: 2px;
    padding: 4px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #E8E8E8;
    border-color: #7A9CC6;
}

QPushButton:pressed {
    background-color: #DCDCDC;
    border-color: #5A7C9E;
}

QPushButton:default {
    border: 1px solid #316AC5;
}

QPushButton:disabled {
    color: #A0A0A0;
    background-color: #F4F4F4;
}

QLineEdit,
QSpinBox,
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #ACA899;
    border-radius: 2px;
    padding: 2px 4px;
    min-height: 18px;
    selection-background-color: #3399FF;
    selection-color: #FFFFFF;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border: 1px solid #3399FF;
}

/* Vista de archivo: fondo blanco, rejilla punteada como WinRAR. */
QTreeView,
QTableView,
QListView {
    background-color: #FFFFFF;
    alternate-background-color: #FFFFFF;
    border: 1px solid #ACA899;
    selection-background-color: #3399FF;
    selection-color: #FFFFFF;
    outline: none;
}

QTreeView::item,
QTableView::item {
    padding: 1px 2px;
    border: none;
}

QTreeView::item:selected,
QTreeView::item:selected:active,
QTableView::item:selected,
QTableView::item:selected:active {
    background-color: #3399FF;
    color: #FFFFFF;
}

QTreeView::item:hover,
QTableView::item:hover {
    background-color: #EAF3FE;
}

QTreeView::item:selected:hover,
QTableView::item:selected:hover {
    background-color: #3399FF;
}

QHeaderView::section {
    background-color: #F0F0F0;
    border: none;
    border-right: 1px solid #D4D0C8;
    border-bottom: 1px solid #ACA899;
    padding: 3px 6px;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #E4E4E4;
}

QHeaderView::down-arrow,
QHeaderView::up-arrow {
    width: 11px;
    height: 11px;
}

QTabWidget::pane {
    border: 1px solid #ACA899;
    background-color: #F0F0F0;
    top: -1px;
}

QTabBar::tab {
    background-color: #E0E0E0;
    border: 1px solid #ACA899;
    border-bottom: none;
    padding: 4px 12px;
    margin-right: 1px;
}

QTabBar::tab:selected {
    background-color: #F0F0F0;
    border-bottom: 1px solid #F0F0F0;
    top: 1px;
}

QStatusBar {
    background-color: #F0F0F0;
    border-top: 1px solid #D4D0C8;
}

QStatusBar::item {
    border: none;
}

QProgressBar {
    background-color: #FFFFFF;
    border: 1px solid #ACA899;
    border-radius: 1px;
    text-align: center;
    height: 14px;
}

QProgressBar::chunk {
    background-color: #3399FF;
    margin: 1px;
}

QCheckBox,
QRadioButton {
    spacing: 6px;
    padding: 1px;
}

QGroupBox {
    border: 1px solid #ACA899;
    border-radius: 2px;
    margin-top: 8px;
    padding-top: 6px;
    background-color: #F0F0F0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    font-weight: bold;
}

QScrollBar:vertical {
    background-color: #F0F0F0;
    width: 16px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #CDCDCD;
    border: 1px solid #A6A6A6;
    border-radius: 2px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B8B8B8;
}

QScrollBar:horizontal {
    background-color: #F0F0F0;
    height: 16px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #CDCDCD;
    border: 1px solid #A6A6A6;
    border-radius: 2px;
    min-width: 24px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
    width: 0;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background-color: #E8E8E8;
}

QToolTip {
    background-color: #FFFFE1;
    color: #000000;
    border: 1px solid #ACA899;
    padding: 2px 4px;
}

QSplitter::handle {
    background-color: #D4D0C8;
}

QSplitter::handle:horizontal {
    width: 3px;
}
